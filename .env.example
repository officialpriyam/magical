# =============================================================================
# Magical AI — Environment Variables
# =============================================================================

# ─── Supabase ─────────────────────────────────────────────────
# Your Supabase project URL and anon key (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key for server-side operations (optional, enables admin features)
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI Model Providers ───────────────────────────────────────
# Add at least one provider API key to use AI models

# OpenAI
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google (Gemini)
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenRouter (multi-provider gateway)
OPENROUTER_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Mistral
MISTRAL_API_KEY=

# Groq
GROQ_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# ─── Web Search ───────────────────────────────────────────────
# Self-hosted open-webSearch (primary — no API key needed)
# Your hosted URL, e.g. https://your-instance.onrender.com
OPEN_WEBSEARCH_URL=

# Exa AI search (fallback — get key at https://exa.ai)
EXA_API_KEY=

# Brave Search (fallback — get key at https://brave.com/search/api/)
BRAVE_SEARCH_API_KEY=

# ─── Morph (apply-based code editing) ─────────────────────────
MORPH_API_KEY=
NEXT_PUBLIC_USE_MORPH_APPLY=false

# ─── Sandbox Providers ────────────────────────────────────────
# At least one is required for preview/IDE to work

# E2B (default sandbox — get key at https://e2b.dev)
E2B_API_KEY=

# Vercel (for Vercel sandbox deployment)
VERCEL_TOKEN=

# Modal (for Modal sandbox)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ─── Analytics ────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_POSTHOG=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW=60000

# ─── Email Validation ─────────────────────────────────────────
ZEROBOUNCE_API_KEY=

# ─── UI Configuration ─────────────────────────────────────────
# Hide models from specific providers in the model selector
NEXT_PUBLIC_HIDE_LOCAL_MODELS=false

# Disable API key input in settings (for managed deployments)
NEXT_PUBLIC_NO_API_KEY_INPUT=false

# Disable base URL input in settings (for managed deployments)
NEXT_PUBLIC_NO_BASE_URL_INPUT=false

# RustFS persistent project storage. Keep these server-only; never use NEXT_PUBLIC_.
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=sandbox-storage
RUSTFS_REGION=us-east-1
