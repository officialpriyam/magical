# Magical AI environment example
# Copy this file to .env.local for local development.
# Do not commit real secrets.

# App URL
# Use your production URL in Vercel, for example https://magicalai.iampriyam.me.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# E2B sandbox execution
# Optional when Vercel Sandbox is configured.
E2B_API_KEY=
E2B_SECURE_ACCESS=true

# Vercel Sandbox execution
# Optional. On Vercel, OIDC is preferred. Locally, run `vercel link`
# and `vercel env pull` to populate VERCEL_OIDC_TOKEN, or use access-token auth.
VERCEL_OIDC_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=
VERCEL_SANDBOX_NODE_RUNTIME=node24
VERCEL_SANDBOX_PYTHON_RUNTIME=python3.13
VERCEL_SANDBOX_VCPUS=2

# AI providers
# At least one hosted provider key is recommended.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
GOOGLE_VERTEX_CREDENTIALS=
MISTRAL_API_KEY=
GROQ_API_KEY=
FIREWORKS_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=
# Optional. Defaults to https://integrate.api.nvidia.com/v1.
NVIDIA_BASE_URL=

# Supabase app database: auth, chat history, projects, settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase OAuth connector: lets users connect their Supabase account.
# Create this in Supabase Dashboard > Organization Settings > OAuth Apps.
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
# Optional. Leave blank for auto retry: client_secret_basic, then client_secret_post.
SUPABASE_OAUTH_TOKEN_AUTH_METHOD=

# Optional Supabase project creation defaults.
# SUPABASE_DEFAULT_ORGANIZATION_SLUG is useful when your OAuth app can access
# multiple organizations and you want to prefer one.
SUPABASE_DEFAULT_ORGANIZATION_SLUG=
# Optional override. If blank, Magical picks a nearby supported region from
# the request country or Vercel deployment region.
SUPABASE_DEFAULT_REGION=
SUPABASE_DEFAULT_INSTANCE_SIZE=

# Optional server-owned Supabase fallback.
# Use only if you want all users to share one server-managed Supabase project.
SUPABASE_MANAGEMENT_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_PROJECT_NAME=

# GitHub OAuth connector
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=
GITHUB_TOKEN_ENCRYPTION_KEY=

# Optional external sandbox storage service.
# Run apps/sandbox-storage on another machine and point Magical at it.
SANDBOX_STORAGE_URL=
SANDBOX_STORAGE_TOKEN=
SANDBOX_STORAGE_ID_SALT=

# Optional Cloudflare R2 private workspace backup
# Legacy fallback when external sandbox storage is not configured.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Rate limiting and short URLs through Vercel KV
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=
RATE_LIMIT_WINDOW=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional Morph apply mode
NEXT_PUBLIC_USE_MORPH_APPLY=false
MORPH_API_KEY=

# Optional client controls
NEXT_PUBLIC_HIDE_LOCAL_MODELS=
NEXT_PUBLIC_NO_API_KEY_INPUT=
NEXT_PUBLIC_NO_BASE_URL_INPUT=

# Optional PostHog analytics
NEXT_PUBLIC_ENABLE_POSTHOG=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_SESSION_REPLAY=false

# Optional email validation
ZEROBOUNCE_API_KEY=
