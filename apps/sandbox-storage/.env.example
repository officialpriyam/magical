# Server configuration
PORT=8787
SANDBOX_STORAGE_ROOT=./data

# Authentication (at least one method required for production)
SANDBOX_STORAGE_TOKEN=
SANDBOX_STORAGE_ACCESS_KEY=
SANDBOX_STORAGE_ACCESS_SALT=

# Redis cache (optional but recommended for production)
REDIS_URL=redis://localhost:6379

# File limits
SANDBOX_STORAGE_MAX_FILES=1000
SANDBOX_STORAGE_MAX_FILE_BYTES=1048576
SANDBOX_STORAGE_MAX_BODY_BYTES=10485760
